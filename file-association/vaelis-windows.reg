Windows Registry Editor Version 5.00

; Gives .vs files the Vaelis icon and the type name "Vaelis Project".
; 1. Copy vaelis-project.ico somewhere permanent (for example
;    C:\Users\YOU\AppData\Local\Vaelis\vaelis-project.ico)
; 2. Change the DefaultIcon path below to match (backslashes doubled).
; 3. Double-click this file, then restart Explorer (or sign out and in).
; Per-user only (HKCU); nothing system-wide is touched.

[HKEY_CURRENT_USER\Software\Classes\.vs]
@="Vaelis.Project"
"Content Type"="application/x-vaelis-project"

[HKEY_CURRENT_USER\Software\Classes\Vaelis.Project]
@="Vaelis Project"

[HKEY_CURRENT_USER\Software\Classes\Vaelis.Project\DefaultIcon]
@="C:\\Users\\YOU\\AppData\\Local\\Vaelis\\vaelis-project.ico"
